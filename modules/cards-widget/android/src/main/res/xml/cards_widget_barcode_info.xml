<?xml version="1.0" encoding="utf-8"?>
<!-- P7: 4 x 2 barcode widget (first widget card). updatePeriodMillis 0: the app pushes every change. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/cards_widget_barcode_description"
    android:initialLayout="@layout/cards_widget_barcode"
    android:previewLayout="@layout/cards_widget_barcode"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="250dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />

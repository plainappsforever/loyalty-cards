<?xml version="1.0" encoding="utf-8"?>
<!-- P7: 2 x 2 grid of four card tiles. updatePeriodMillis 0: the app pushes every change (start, background, card open). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:description="@string/cards_widget_grid_description"
    android:initialLayout="@layout/cards_widget_grid"
    android:previewLayout="@layout/cards_widget_grid"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    tools:targetApi="31" />

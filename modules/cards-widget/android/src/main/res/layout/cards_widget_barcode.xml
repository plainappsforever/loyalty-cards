<?xml version="1.0" encoding="utf-8"?>
<!-- P7 "Barcode" 4x2 widget (CardsWidgets.renderBarcode). RemoteViews-safe views only. The code PNG is drawn at its own
     pixel size (centerInside never enlarges; it only shrinks on a launcher with smaller cells), on a white panel so the
     quiet zone is white in dark mode too. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cards_widget_barcode_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/cards_widget_bg"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/cards_widget_barcode_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp">

                <ImageView
                    android:id="@+id/cards_widget_barcode_tile_bg"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/cards_widget_tile" />

                <TextView
                    android:id="@+id/cards_widget_barcode_tile_initials"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:gravity="center"
                    android:maxLines="1"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </FrameLayout>

            <TextView
                android:id="@+id/cards_widget_barcode_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="1"
            android:background="@drawable/cards_widget_code_bg">

            <ImageView
                android:id="@+id/cards_widget_barcode_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside" />

            <TextView
                android:id="@+id/cards_widget_barcode_hint"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="6dp"
                android:textColor="#000000"
                android:textSize="13sp"
                android:visibility="gone" />
        </FrameLayout>

        <TextView
            android:id="@+id/cards_widget_barcode_number"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="monospace"
            android:gravity="center_horizontal"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/cards_widget_barcode_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:padding="6dp"
        android:text="@string/cards_widget_barcode_label"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:visibility="gone" />
</FrameLayout>
